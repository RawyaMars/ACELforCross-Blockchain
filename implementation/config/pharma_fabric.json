{
  "BC reference": {
    "NAME": "Hyperledger Fabric",
    "BLOCKCHAINID": "PharmaChannel"
  },
  "SC reference": {
    "CONTRACTID": "pharmatrace-cc",
    "startBlock": 1,
    "endBlock": 500000
  },
  "Correlation": {
    "caseKeyField": "lotId",
    "artifactTypes": ["Lot"]
  },
  "Artifacts": {
    "Lot": {
      "attributes": ["lotId", "product", "quantity", "manufacturer", "status"]
    },
    "RawMaterialBatch": {
      "attributes": ["batchId", "materialName", "supplier", "quantity"]
    },
    "Shipment": {
      "attributes": ["shipmentId", "carrier", "destination", "status"]
    }
  },
  "Relations": {
    "usesRawMaterial": {
      "source": "RawMaterialBatch",
      "target": "Lot",
      "cardinality": "many2one"
    },
    "hasShipment": {
      "source": "Lot",
      "target": "Shipment",
      "cardinality": "one2one"
    }
  },
  "Events": {
    "LotCreated": {
      "activity": "LotCreated",
      "objects": [
        { "type": "Lot", "idField": "lotId", "attributes": ["lotId", "product", "quantity", "manufacturer", "status"], "lifecycle": "created" }
      ],
      "relations": []
    },
    "RawMaterialReceived": {
      "activity": "RawMaterialReceived",
      "objects": [
        { "type": "RawMaterialBatch", "idField": "batchId", "attributes": ["batchId", "materialName", "supplier", "quantity"], "lifecycle": "created" },
        { "type": "Lot", "idField": "lotId", "attributes": [], "lifecycle": "updated" }
      ],
      "relations": [
        { "type": "usesRawMaterial", "sourceField": "batchId", "targetField": "lotId" }
      ]
    },
    "QualityControlApproved": {
      "activity": "QualityControlApproved",
      "objects": [
        { "type": "Lot", "idField": "lotId", "attributes": ["status"], "lifecycle": "updated" }
      ],
      "relations": []
    },
    "QualityControlRejected": {
      "activity": "QualityControlRejected",
      "objects": [
        { "type": "Lot", "idField": "lotId", "attributes": ["status"], "lifecycle": "updated" }
      ],
      "relations": []
    },
    "LotShipped": {
      "activity": "LotShipped",
      "objects": [
        { "type": "Shipment", "idField": "shipmentId", "attributes": ["shipmentId", "carrier", "destination", "status"], "lifecycle": "created" },
        { "type": "Lot", "idField": "lotId", "attributes": ["status"], "lifecycle": "updated" }
      ],
      "relations": [
        { "type": "hasShipment", "sourceField": "lotId", "targetField": "shipmentId" }
      ]
    },
    "LotDelivered": {
      "activity": "LotDelivered",
      "objects": [
        { "type": "Shipment", "idField": "shipmentId", "attributes": ["status"], "lifecycle": "updated" },
        { "type": "Lot", "idField": "lotId", "attributes": ["status"], "lifecycle": "updated" }
      ],
      "relations": []
    }
  }
}
